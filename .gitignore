# CMake
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
_deps/
compile_commands.json
Makefile
CPackConfig.cmake
CPackSourceConfig.cmake

# Compiler / linker outputs
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk

# Benchmark harness binaries built from the CMakeLists targets (source-tree
# builds only; out-of-tree builds under build/ are already covered above).
/benchmarks/*/fp_bench_a
/benchmarks/*/fp_bench_b
/benchmarks/*/fx64_bench
/benchmarks/*/fx128_bench
/benchmarks/*/search_fp
/benchmarks/*/search_fp_b
/benchmarks/*/search_fx64

# Profiling / perf / disassembly scratch output regenerated by tools/*.py.
# Committed reference results live under benchmarks/*/results/ and are
# intentionally NOT ignored - see each benchmark's README for how they were
# produced and how to regenerate them.
perf.data
perf.data.old
*.perf
*.prof

# Scratch dump directory written by benchmarks/search/tools/verify_equivalence.py
_dumps/

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
